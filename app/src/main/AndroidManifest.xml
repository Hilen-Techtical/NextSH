<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biométrie -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- dataSync : transferts SFTP, finis et déclenchés par l'utilisateur, et le choix du
         fichier dans le sélecteur du système qui les précède (maintien borné à 10 min).
         Soumis au quota de 6 h par 24 h en arrière-plan depuis targetSdk 35. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- specialUse : tunnels SSH persistants et sessions de terminal ouvertes.
         Aucun autre type ne convient, voir docs/play-foreground-service-justification.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notifications des services au premier plan (Android 13+). Sans elle,
         la notification de tunnel, celle de transfert et celle des sessions
         de terminal n'apparaissent pas dans le volet, donc leurs actions sont
         inatteignables. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Import fichiers (SAF) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- FIDO2 Security Key (USB + NFC) -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Scan QR d'enrôlement Desktop (Phase 2 Sync LAN) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SSHVault"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Sécurité : pas de screenshots sur écrans sensibles (géré par code) -->

        <!-- Portrait par défaut : sur téléphone, le paysage n'apporte rien aux
             listes et aux formulaires, et dégrade la saisie. Les seuls écrans
             qui y gagnent, terminal, explorateur SFTP et navigateur de tunnel,
             demandent la liberté d'orientation à l'exécution depuis NavGraph.
             Android 16 ignore cette valeur au-delà de 600 dp, où la rotation
             redevient libre : c'est le comportement voulu, la contrainte ne
             vise que le téléphone. -->

        <!-- Clavier et navigation exclus de la recréation : une YubiKey se
             déclare aussi comme clavier USB, et son branchement change la
             configuration keyboard / keyboardHidden (Android 10 à 15). Sans
             cette déclaration, l'activité est recréée au branchement de la
             clé, en pleine demande de signature FIDO2. Android 16 avec
             targetSdk 36 ne la recrée plus pour ce motif. Aucune ressource
             n'a de qualificatif de clavier ou de navigation. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SSHVault.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trampoline invisible pour USB_DEVICE_ATTACHED. Ne lance pas
             MainActivity en cold-start ; le device est forwardé à
             SecurityKeyDiscovery UNIQUEMENT si quelqu'un cherche une clé
             (demande de signature FIDO2 ou écran d'enrôlement : un bail est pris). -->
        <activity
            android:name=".ui.vault.Fido2UsbHandlerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/yubikey_device_filter" />
        </activity>

        <!-- Foreground Service pour tunnels SSH persistants.
             Type specialUse et non dataSync : un tunnel n'est pas un transfert
             fini, et le quota dataSync de 6 h par 24 h le tuerait en pleine
             utilisation. Justification pour la revue Play :
             docs/play-foreground-service-justification.md -->
        <service
            android:name=".service.TunnelForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains user-initiated SSH port-forwarding tunnels for as long as the user keeps them open" />
        </service>

        <!-- Foreground Service pour les sessions de terminal SSH ouvertes.
             Type specialUse pour la meme raison que les tunnels : une session
             n'est pas un transfert fini, elle reste ouverte tant que
             l'utilisateur ne la ferme pas. Sans lui, Android coupe les sockets
             de l'app peu apres son passage en arriere-plan. Justification pour
             la revue Play : docs/play-foreground-service-justification.md -->
        <service
            android:name=".service.TerminalSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the SSH terminal sessions the user opened connected while the user switches to another app, until the user closes them" />
        </service>

        <!-- Foreground Service pour les transferts SFTP (upload / download) -->
        <service
            android:name=".service.SftpTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
