<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Réseau -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Biométrie -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- dataSync : transferts SFTP, finis et déclenchés par l'utilisateur.
         Soumis au quota de 6 h par 24 h en arrière-plan depuis targetSdk 35. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- specialUse : tunnels SSH persistants. Aucun autre type ne convient,
         voir docs/play-foreground-service-justification.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Notifications des services au premier plan (Android 13+). Sans elle,
         la notification de tunnel et celle de transfert n'apparaissent pas
         dans le volet, donc leurs actions sont inatteignables. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Import fichiers (SAF) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- FIDO2 Security Key (USB + NFC) -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Scan QR d'enrôlement Desktop (Phase 2 Sync LAN) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.SSHVault"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Sécurité : pas de screenshots sur écrans sensibles (géré par code) -->

        <!-- Portrait par défaut : sur téléphone, le paysage n'apporte rien aux
             listes et aux formulaires, et dégrade la saisie. Les seuls écrans
             qui y gagnent, terminal, explorateur SFTP et navigateur de tunnel,
             demandent la liberté d'orientation à l'exécution depuis NavGraph.
             Android 16 ignore cette valeur au-delà de 600 dp, où la rotation
             redevient libre : c'est le comportement voulu, la contrainte ne
             vise que le téléphone. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.SSHVault.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trampoline invisible pour USB_DEVICE_ATTACHED. Ne lance pas
             MainActivity en cold-start ; le device est forwardé au
             Fido2EnrollManager UNIQUEMENT si l'app est déjà ouverte sur
             l'écran d'enrôlement FIDO2 (yubiKitManager actif). -->
        <activity
            android:name=".ui.vault.Fido2UsbHandlerActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/yubikey_device_filter" />
        </activity>

        <!-- Foreground Service pour tunnels SSH persistants.
             Type specialUse et non dataSync : un tunnel n'est pas un transfert
             fini, et le quota dataSync de 6 h par 24 h le tuerait en pleine
             utilisation. Justification pour la revue Play :
             docs/play-foreground-service-justification.md -->
        <service
            android:name=".service.TunnelForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Maintains user-initiated SSH port-forwarding tunnels for as long as the user keeps them open" />
        </service>

        <!-- Foreground Service pour les transferts SFTP (upload / download) -->
        <service
            android:name=".service.SftpTransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
