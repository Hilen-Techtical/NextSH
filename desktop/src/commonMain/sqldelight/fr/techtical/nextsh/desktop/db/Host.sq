CREATE TABLE hosts (
    id TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    hostname TEXT NOT NULL,
    port INTEGER NOT NULL DEFAULT 22,
    username TEXT NOT NULL,
    authType TEXT NOT NULL,
    credentialId TEXT NOT NULL,
    "group" TEXT,
    keepAliveSeconds INTEGER NOT NULL DEFAULT 30,
    autoReconnect INTEGER NOT NULL DEFAULT 1,
    terminalTheme TEXT NOT NULL DEFAULT 'TECHTICAL_DARK',
    fido2Mode TEXT,
    isFavorite INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    lastConnectedAt INTEGER,
    vectorClock TEXT NOT NULL DEFAULT '{}',
    deleted INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    updatedAt INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM hosts WHERE deleted = 0 ORDER BY label;

selectAllIncludingDeleted:
SELECT * FROM hosts ORDER BY label;

selectById:
SELECT * FROM hosts WHERE id = ? AND deleted = 0;

selectFavorites:
SELECT * FROM hosts WHERE isFavorite = 1 AND deleted = 0 ORDER BY label;

selectByGroup:
SELECT * FROM hosts WHERE "group" = ? AND deleted = 0 ORDER BY label;

selectGroups:
SELECT DISTINCT "group" FROM hosts WHERE "group" IS NOT NULL AND deleted = 0 ORDER BY "group";

insert:
INSERT OR REPLACE INTO hosts(id, label, hostname, port, username, authType, credentialId, "group", keepAliveSeconds, autoReconnect, terminalTheme, fido2Mode, isFavorite, createdAt, lastConnectedAt, vectorClock, deleted, deletedAt, updatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

update:
UPDATE hosts SET label = ?, hostname = ?, port = ?, username = ?, authType = ?, credentialId = ?, "group" = ?, keepAliveSeconds = ?, autoReconnect = ?, terminalTheme = ?, fido2Mode = ?, isFavorite = ?, vectorClock = ?, updatedAt = ?
WHERE id = ?;

updateLastConnected:
UPDATE hosts SET lastConnectedAt = ? WHERE id = ?;

setFavorite:
UPDATE hosts SET isFavorite = ? WHERE id = ?;

markDeleted:
UPDATE hosts SET deleted = 1, deletedAt = ?, updatedAt = ?, vectorClock = ? WHERE id = ?;

delete:
DELETE FROM hosts WHERE id = ?;
